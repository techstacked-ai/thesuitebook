# Markdown copies of every page for AI agents (scripts/markdown/build.mjs). Kept out of search results: the HTML page is
# the canonical one, and it links its copy with rel="alternate" type="text/markdown".
/*.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex
  Link: <https://thesuitebook.com/llms.txt>; rel="describedby"

/llms.txt
  Content-Type: text/plain; charset=utf-8
/llms-full.txt
  Content-Type: text/plain; charset=utf-8

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/photos/*
  Cache-Control: public, max-age=2592000
