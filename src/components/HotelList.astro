---
/* The editorial list on region, destination and theme pages: one photograph and a few lines per hotel. */
import { hotelPath, placeLine, leadOf, srcset } from '../lib/hotels';
import type { Hotel } from '../lib/hotels';
interface Props { list: Hotel[]; numbered?: boolean }
const { list, numbered = false } = Astro.props;
---
<ol class:list={['list', { numbered }]}>
  {list.map((h, i) => { const p = leadOf(h)!; return (
    <li>
      <a href={hotelPath(h)}>
        <img src={p.srcMid || p.src} srcset={srcset(p)} sizes="(max-width: 760px) 100vw, 56vw" width={p.width} height={p.height} alt={`${h.name}, ${placeLine(h)}`} loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
        <div class="text">
          {numbered ? <span class="n">{String(i + 1).padStart(2, '0')}</span> : null}
          <h2>{h.name}</h2>
          <p class="label">{placeLine(h)}</p>
          {h.tagline ? <p class="tag">{h.tagline}</p> : null}
        </div>
      </a>
    </li>
  ); })}
</ol>

<style>
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(72px, 9vw, 136px); }
  li a { display: grid; grid-template-columns: 7fr 4fr; gap: clamp(28px, 4vw, 72px); align-items: end; }
  li:nth-child(even) a { grid-template-columns: 4fr 7fr; }
  li:nth-child(even) img { order: 2; }
  img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; background: var(--line); }
  h2 { font-size: clamp(28px, 2.8vw, 40px); }
  .label { margin-top: 12px; }
  .tag { margin-top: 20px; font-family: var(--serif); font-size: 18px; line-height: 1.55; max-width: 34ch; }
  .n { display: block; margin-bottom: 18px; font-size: 13px; color: var(--soft); }
  li a:hover h2 { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 7px; }
  @media (max-width: 760px) { li a, li:nth-child(even) a { grid-template-columns: 1fr; gap: 22px; } li:nth-child(even) img { order: 0; } }
</style>
