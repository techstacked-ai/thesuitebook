---
import Base from '../../layouts/Base.astro';
import { hotels, hotelPath, placeLine, paragraphs, srcset, booking, SPONSORED, sources, host, longDate, num, regionPath, places, MIN_REVIEWS, SITE } from '../../lib/hotels';
import type { Hotel } from '../../lib/hotels';
export function getStaticPaths() { return hotels.map((h) => ({ params: { slug: h.slug }, props: { h } })); }
const { h } = Astro.props as { h: Hotel };
const photos = h.photos || [];
const [lead, ...rest] = photos;
const paras = paragraphs(h);
const [answer, ...body] = paras;
/* Prose and photographs alternate: a photograph, then a paragraph, until one runs out; what is left follows. */
const blocks: ({ kind: 'p'; text: string } | { kind: 'img'; i: number })[] = [];
const n = Math.max(body.length, rest.length);
for (let i = 0; i < n; i++) { if (rest[i]) blocks.push({ kind: 'img', i }); if (body[i]) blocks.push({ kind: 'p', text: body[i] }); }
const place = placeLine(h);
const book = booking(h);
const dest = places().filter((p) => p.list.includes(h));

const rows: [string, string][] = [];
if (h.rooms) rows.push(['Rooms and suites', num(h.rooms)]);
if (h.suites) rows.push(['Suites', num(h.suites)]);
if (h.villas) rows.push(['Villas', num(h.villas)]);
if (h.opened) rows.push(['Opened', String(h.opened)]);
if (h.operator || h.brand) rows.push(['Operator', [h.operator, h.brand && h.brand !== h.operator ? `(${h.brand})` : ''].filter(Boolean).join(' ')]);
if (h.price?.from) rows.push(['Nightly from', `About US$${num(Math.round(h.price.from / 10) * 10)}`]);
if (h.airport?.code) rows.push(['Nearest airport', `${h.airport.code}${h.airport.minutes ? `, ${h.airport.minutes} minutes` : ''}`]);
if (h.adultsOnly) rows.push(['Guests', 'Adults only']);
if (h.address) rows.push(['Address', h.address]);

/* Questions answered from the file's own fields, shown on the page and marked up as FAQ. */
const faq: { q: string; a: string }[] = [];
faq.push({ q: `Where is ${h.name}?`, a: `${h.name} is in ${place}${h.address ? `, at ${h.address}` : ''}.` });
if (h.rooms) faq.push({ q: `How many rooms does ${h.name} have?`, a: `${num(h.rooms)} rooms and suites${h.suites ? `, ${num(h.suites)} of them suites` : ''}${h.villas ? `, with ${num(h.villas)} villas` : ''}.` });
if (h.opened) faq.push({ q: `When did ${h.name} open?`, a: `${h.opened}.` });
if (h.airport?.code) faq.push({ q: `What is the nearest airport to ${h.name}?`, a: `${h.airport.code}${h.airport.minutes ? `, about ${h.airport.minutes} minutes away` : ''}.` });
if (h.operator) faq.push({ q: `Who runs ${h.name}?`, a: `${h.operator}.` });
if (h.price?.from) faq.push({ q: `How much does ${h.name} cost a night?`, a: `Rooms started at about US$${num(Math.round(h.price.from / 10) * 10)} a night for two adults when last sampled${h.price.date ? ` (${longDate(h.price.date)})` : ''}. Prices change with the dates.` });

const url = new URL(hotelPath(h), SITE).href;
const hotelLd: Record<string, unknown> = {
  '@context': 'https://schema.org', '@type': h.type === 'resort' || h.type === 'island' ? 'Resort' : 'Hotel', name: h.name, url, description: answer,
  image: photos.slice(0, 5).map((p) => new URL(p.src, SITE).href), sameAs: h.officialSite,
  address: { '@type': 'PostalAddress', ...(h.address ? { streetAddress: h.address } : {}), ...(h.city ? { addressLocality: h.city } : {}), addressCountry: h.country },
  ...(h.lat && h.lng ? { geo: { '@type': 'GeoCoordinates', latitude: h.lat, longitude: h.lng } } : {}),
  ...(h.rooms ? { numberOfRooms: h.rooms } : {}),
  ...(h.rating && h.rating.reviews >= MIN_REVIEWS ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: h.rating.score, bestRating: 10, worstRating: 1, reviewCount: h.rating.reviews } } : {}),
};
const ld = [
  hotelLd,
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [['The Suite Book', '/'], [h.region, regionPath(h.region)], [h.name, hotelPath(h)]].map(([name, p], i) => ({ '@type': 'ListItem', position: i + 1, name, item: new URL(p, SITE).href })) },
];
const near = hotels.filter((x) => x.region === h.region && x.slug !== h.slug).slice(0, 6);
const alt = (i: number) => photos[i].caption || `${h.name}, ${place}`;
const title = `${h.name}, ${h.city || h.country} | The Suite Book`;
const description = (h.tagline ? `${h.tagline} ` : '') + (answer || '').slice(0, 150).replace(/\s\S*$/, '') + '.';
---
<Base title={title} description={description.slice(0, 160)} image={lead.src} overlay updated={h.lastVerified} ld={ld}>
  <figure class="lead">
    <img src={lead.srcHero || lead.src} srcset={srcset(lead, true)} sizes="100vw" width={lead.width} height={lead.height} alt={alt(0)} fetchpriority="high" decoding="async" />
  </figure>

  <header class="head measure">
    <p class="label"><a href={regionPath(h.region)}>{h.region}</a></p>
    <h1>{h.name}</h1>
    <p class="place">{place}</p>
  </header>

  {answer ? <p class="answer measure">{answer}</p> : null}

  <div class="story">
    {blocks.map((b, k) => b.kind === 'p'
      ? <p class="prose measure">{b.text}</p>
      : (() => { const p = rest[b.i]; const wide = b.i % 3 === 0; return (
          <figure class:list={['ph', wide ? 'wide' : k % 2 ? 'left' : 'right']}>
            <img src={p.srcMid || p.src} srcset={srcset(p)} sizes={wide ? '(max-width: 760px) 100vw, 88vw' : '(max-width: 760px) 100vw, 60vw'} width={p.width} height={p.height} alt={alt(b.i + 1)} loading="lazy" decoding="async" />
          </figure>
        ); })())}
  </div>

  <section class="details wrap" aria-labelledby="facts-h">
    <div class="col">
      <h2 id="facts-h">The facts</h2>
      <dl class="facts">{rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
    </div>
    {h.highlights?.length ? (
      <div class="col">
        <h2>Worth knowing</h2>
        <dl class="facts hl">{h.highlights.map((x) => <div><dt>{x.label}</dt><dd>{x.value}</dd></div>)}</dl>
      </div>
    ) : null}
  </section>

  <section class="book measure" aria-label="Booking">
    <a class="button" href={book.url} rel={book.affiliate ? SPONSORED : 'noopener'} target="_blank">{book.label}</a>
    {book.affiliate ? <p class="label">Through Stay22 on {book.supplier === 'booking' ? 'Booking.com' : 'Expedia'}. Or <a class="quiet-link" href={h.officialSite} rel="noopener" target="_blank">reserve on the hotel's own site</a>.</p>
      : <p class="label">On {host(h.officialSite)}, the hotel's own site.</p>}
  </section>

  {faq.length > 1 ? (
    <section class="faq measure" aria-labelledby="faq-h">
      <h2 id="faq-h">Questions</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
  ) : null}

  <section class="sources measure" aria-labelledby="src-h">
    <h2 id="src-h" class="label">Sources</h2>
    <ul>{sources(h).map((s) => <li><a href={s.url} rel="noopener nofollow" target="_blank">{host(s.url)}{new URL(s.url).pathname.replace(/\/$/, '')}</a> <span>read {longDate(s.date)}</span></li>)}</ul>
    <p class="label credits">Photographs: {[...new Set(photos.map((p) => p.credit))].join(', ')}.</p>
  </section>

  {near.length || dest.length ? (
    <nav class="more wrap" aria-label="More hotels">
      <h2>Also in {h.region}</h2>
      <ul>{near.map((x) => <li><a href={hotelPath(x)}><span>{x.name}</span><span class="label">{placeLine(x)}</span></a></li>)}</ul>
      <p class="label links"><a class="quiet-link" href={regionPath(h.region)}>All of {h.region}</a>{dest.map((d) => <a class="quiet-link" href={d.path}>The most luxurious hotels in {d.name}</a>)}</p>
    </nav>
  ) : null}
</Base>

<style>
  .lead { margin: 0; height: 100svh; min-height: 520px; background: var(--midnight); }
  .lead { position: relative; }
  .lead::after { content: ''; position: absolute; inset: 0; background: rgba(10, 14, 20, 0.1); pointer-events: none; }
  .lead img { width: 100%; height: 100%; object-fit: cover; }
  .head { text-align: center; padding-top: clamp(72px, 9vw, 128px); }
  .head .label a:hover { color: var(--ink); }
  h1 { margin-top: 22px; font-size: clamp(38px, 5.4vw, 76px); }
  .place { margin-top: 18px; font-size: 14px; color: var(--soft); }
  .answer { margin-top: clamp(56px, 6vw, 88px); font-family: var(--serif); font-size: clamp(21px, 1.9vw, 26px); line-height: 1.55; }
  .story { display: grid; gap: clamp(56px, 7vw, 104px); margin-top: clamp(72px, 9vw, 128px); }
  .ph { margin: 0; }
  .ph img { width: 100%; height: auto; }
  .ph.wide { width: min(1560px, 100% - 2 * var(--pad)); margin-inline: auto; }
  .ph.left { width: min(820px, 62%); margin-left: var(--pad); }
  .ph.right { width: min(820px, 62%); margin-left: auto; margin-right: var(--pad); }
  .details { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 120px); margin-top: var(--pause); padding-top: 64px; border-top: 1px solid var(--line); }
  h2 { font-size: clamp(26px, 2.4vw, 34px); }
  .facts { margin: 32px 0 0; }
  .facts div { display: grid; grid-template-columns: 11em 1fr; gap: 20px; padding-block: 14px; border-bottom: 1px solid var(--line); }
  .facts div:first-child { border-top: 1px solid var(--line); }
  dt { font-size: 13px; color: var(--soft); padding-top: 3px; }
  dd { margin: 0; font-family: var(--serif); font-size: 17px; line-height: 1.5; }
  .hl div { grid-template-columns: 1fr; gap: 4px; }
  .book { margin-top: clamp(80px, 9vw, 128px); text-align: center; display: grid; justify-items: center; gap: 20px; }
  .faq { margin-top: var(--pause); }
  details { border-bottom: 1px solid var(--line); }
  details:first-of-type { margin-top: 28px; border-top: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding-block: 18px; font-family: var(--serif); font-size: 19px; display: flex; justify-content: space-between; gap: 24px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font-family: var(--sans); color: var(--soft); }
  details[open] summary::after { content: '\2212'; }
  details p { padding-bottom: 20px; font-family: var(--serif); font-size: 17px; line-height: 1.6; }
  .sources { margin-top: 88px; }
  .sources h2 { font-family: var(--sans); font-size: 13px; color: var(--soft); letter-spacing: 0.01em; }
  .sources ul { list-style: none; padding: 0; margin: 14px 0 0; font-size: 13px; display: grid; gap: 6px; overflow-wrap: anywhere; }
  .sources a { border-bottom: 1px solid var(--line); }
  .sources a:hover { border-color: var(--ink); }
  .sources span { color: var(--faint); }
  .credits { margin-top: 18px; }
  .more { margin-top: var(--pause); padding-top: 64px; border-top: 1px solid var(--line); }
  .more ul { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 48px; }
  .more li a { display: grid; gap: 2px; padding-block: 16px; border-bottom: 1px solid var(--line); font-family: var(--serif); font-size: 20px; }
  .more li a:hover span:first-child { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px 32px; margin-top: 36px; }
  @media (max-width: 900px) { .details { grid-template-columns: 1fr; } .more ul { grid-template-columns: 1fr; } }
  @media (max-width: 760px) {
    .lead { height: 78svh; }
    .ph.left, .ph.right { width: 100%; margin: 0; }
    .ph.wide { width: 100%; }
    .facts div { grid-template-columns: 1fr; gap: 2px; }
  }
  @media (pointer: coarse) { summary { padding-block: 20px; } }
</style>
