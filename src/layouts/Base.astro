---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, NAME, newest } from '../lib/hotels';
/* overlay: the header sits over a full-bleed photograph (home, hotel pages) in white. home: the large centred wordmark replaces the small one. */
interface Props { title: string; description: string; image?: string; noindex?: boolean; updated?: string; overlay?: boolean; home?: boolean; ld?: object[] }
const { title, description, image = '', noindex = false, overlay = false, home = false, ld = [] } = Astro.props;
const updated = Astro.props.updated || newest();
const canonical = noindex ? `${SITE}/` : new URL(Astro.url.pathname, Astro.site || SITE).href;
const mdHref = noindex ? '' : `${canonical.replace(/\/?$/, '/')}index.md`;
const og = image ? new URL(image, Astro.site || SITE).href : '';
const orgLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'Organization', '@id': `${SITE}/#org`, name: NAME, url: `${SITE}/`, logo: `${SITE}/icon-512.png` },
  { '@type': 'WebSite', '@id': `${SITE}/#site`, name: NAME, url: `${SITE}/`, inLanguage: 'en', publisher: { '@id': `${SITE}/#org` },
    potentialAction: { '@type': 'SearchAction', target: { '@type': 'EntryPoint', urlTemplate: `${SITE}/hotels/?q={search_term_string}` }, 'query-input': 'required name=search_term_string' } },
] };
/* Stay22 LetMeAllez with the owner's lmaID, in the setup line only, after load, when idle. */
const lma = `(function (w, d) {
  function go() { w.Stay22 = w.Stay22 || {}; w.Stay22.params = { lmaID: '6a29ef1adf1132ff50147172' };
    var s = d.createElement('script'); s.async = true; s.src = 'https://scripts.stay22.com/letmeallez.js'; d.head.appendChild(s); }
  function idle() { (w.requestIdleCallback || function (f) { setTimeout(f, 1); })(go, { timeout: 4000 }); }
  if (d.readyState === 'complete') idle(); else w.addEventListener('load', idle, { once: true });
})(window, document);`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : null}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    {mdHref ? <link rel="alternate" type="text/markdown" href={mdHref} /> : null}
    {updated ? <meta name="last-modified" content={updated} /> : null}
    <meta property="og:site_name" content={NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {og ? <meta property="og:image" content={og} /> : null}
    {og ? <meta name="twitter:card" content="summary_large_image" /> : null}
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="preload" href="/fonts/bodoni-moda-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-tight-normal-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline set:html={lma} />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
    {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header overlay={overlay} home={home} />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Bodoni Moda'; font-style: normal; font-weight: 400 700; font-display: swap; src: url('/fonts/bodoni-moda-normal-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Bodoni Moda'; font-style: normal; font-weight: 400 700; font-display: swap; src: url('/fonts/bodoni-moda-normal-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Bodoni Moda'; font-style: italic; font-weight: 400; font-display: swap; src: url('/fonts/bodoni-moda-italic-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Bodoni Moda'; font-style: italic; font-weight: 400; font-display: swap; src: url('/fonts/bodoni-moda-italic-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Inter Tight'; font-style: normal; font-weight: 400 600; font-display: swap; src: url('/fonts/inter-tight-normal-latin.woff2') format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Inter Tight'; font-style: normal; font-weight: 400 600; font-display: swap; src: url('/fonts/inter-tight-normal-latin-ext.woff2') format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  :root {
    --paper: #ffffff;
    --ink: #121212;
    --soft: #5e5e5a;
    --faint: #8a8984;
    --line: #e4e2dd;
    --midnight: #1c2733;
    --midnight-deep: #141c25;
    --on-dark: #ffffff;
    --on-dark-soft: rgba(255, 255, 255, 0.68);
    --serif: 'Bodoni Moda', 'Didot', 'Bodoni 72', Georgia, serif;
    --sans: 'Inter Tight', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    --w: 1320px;
    --text: 680px;
    --pad: clamp(20px, 5vw, 72px);
    --pause: clamp(88px, 12vw, 176px);
    --ease: cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  html { -webkit-text-size-adjust: 100%; }
  body { background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 15px; line-height: 1.6; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  h1, h2, h3 { margin: 0; font-family: var(--serif); font-weight: 400; line-height: 1.1; letter-spacing: -0.005em; text-wrap: balance; font-optical-sizing: auto; }
  p { margin: 0; text-wrap: pretty; }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; height: auto; }
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }
  .wrap { width: min(var(--w), 100% - 2 * var(--pad)); margin-inline: auto; }
  .measure { width: min(var(--text), 100% - 2 * var(--pad)); margin-inline: auto; }
  .label { font-family: var(--sans); font-size: 13px; color: var(--soft); letter-spacing: 0.01em; }
  .prose { font-family: var(--serif); font-size: clamp(18px, 1.35vw, 20px); line-height: 1.7; }
  .prose p + p { margin-top: 1.1em; }
  .rule { border: 0; border-top: 1px solid var(--line); margin: 0; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 0 34px; background: var(--midnight); color: var(--on-dark); font-family: var(--sans); font-size: 14px; letter-spacing: 0.02em; border: 1px solid var(--midnight); transition: background-color 300ms var(--ease); }
  .button:hover { background: var(--midnight-deep); }
  .quiet-link { border-bottom: 1px solid var(--line); padding-bottom: 2px; transition: border-color 300ms var(--ease); }
  .quiet-link:hover { border-color: var(--ink); }
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 50; background: var(--paper); padding: 10px 16px; }
  .skip:focus { left: 8px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition: none !important; animation: none !important; } }
</style>
